{
  "name": "@iostack/js-client",
  "version": "0.0.49",
  "description": "A Javascript client wrapping interactions with the iostack inference service",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:types && webpack",
    "build:types": "tsc -p tsconfig.types.json",
    "prepare": "npm run build",
    "test": "npx jest"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iostack-org/js-client.git"
  },
  "author": "iostack.ai",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iostack-org/js-client/issues"
  },
  "homepage": "https://github.com/iostack-org/js-client#readme",
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@types/jest": "^29.5.12",
    "@types/jwt-decode": "^3.1.0",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "dotenv": "^16.4.5",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "undici": "^6.21.3",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
